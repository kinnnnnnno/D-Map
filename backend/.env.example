# 少人数のローカル開発専用。本番では.envを読まず、契約/自前サービスを環境変数で指定します。
# 利用条件: https://operations.osmfoundation.org/policies/nominatim/
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT="d-map/1.0 (venue picker; https://github.com/kinnnnnnno/D-Map)"
